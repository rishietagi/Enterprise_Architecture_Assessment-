{
  "_meta": "Deterministic rule parameters. Every number here is editable in the UI (Settings sheet) and must never be hard-coded elsewhere.",
  "gap_register": {
    "_rule": "Transactional gap: answered L3 with maturity <= l3_maturity_max or any dimension at 1; weak dimension = answer <= weak_dimension_max. Thematic gap: >= theme_min L3 gaps in one L1 share a weak dimension (L0 theme if it recurs in two or more L1s).",
    "l3_maturity_max": 2.5,
    "weak_dimension_max": 2,
    "high_criticality_min": 4,
    "high_maturity_max": 2.0,
    "theme_min": 2
  },
  "capability_rules": {
    "maturity_formula": "mean(process, digital, data, integration)",
    "heat_bands": [
      [
        0,
        1.5,
        "critical"
      ],
      [
        1.5,
        2.5,
        "weak"
      ],
      [
        2.5,
        3.5,
        "developing"
      ],
      [
        3.5,
        5.01,
        "strong"
      ]
    ],
    "gap_if": "importance >= 4 AND maturity <= 2.5",
    "gap_importance_min": 4,
    "gap_maturity_max": 2.5,
    "alignment_min": 3,
    "quadrant_split": 2.5,
    "critical_maturity_max": 1.5,
    "urgency_focus": 5,
    "urgency_default": 3,
    "impact": "importance",
    "urgency": "5 if focus area set else 3; +1 if maturity <= 1.5 (max 5)",
    "togaf_ref": [
      "8.4",
      "27",
      "32",
      "36.2.10"
    ],
    "target_maturity": {
      "5": 4.0,
      "4": 3.5,
      "3": 3.0,
      "2": 2.5,
      "1": 2.0
    },
    "entanglement_high": 8
  },
  "rationalization": {
    "framework": "Business fit x technical fit quadrant (TIME-style) with principle-driven rules, mapped onto TOGAF gap analysis (§27) and the Application Portfolio Catalog (§35.6.5)",
    "business_fit": "mean(bf)",
    "technical_fit": "mean(tf)",
    "threshold": 3.0,
    "matrix": {
      "high_bf_high_tf": "Invest",
      "high_bf_low_tf": "Migrate",
      "low_bf_high_tf": "Tolerate",
      "low_bf_low_tf": "Eliminate"
    },
    "overrides": [
      {
        "if": "in_scope == false",
        "then": "Retain (out of scope)",
        "why": "SAP RISE and OT are outside detailed assessment per proposal"
      },
      {
        "if": "lifecycle == 'EOL < 24m' AND disposition in ['Invest','Tolerate']",
        "then": "Migrate",
        "why": "Vendor support ends inside the roadmap horizon"
      },
      {
        "if": "lifecycle == 'Unknown'",
        "then": "flag 'Validate lifecycle'",
        "why": "Discovery gap, not a disposition"
      }
    ],
    "duplication": "Any capability L2 served by >= 2 in-scope apps -> 'Consolidation candidate' cluster; the app that is system-of-record (sor non-empty) or has highest business_fit is the proposed survivor.",
    "gap_if": "disposition in ['Migrate','Eliminate'] OR member of a duplication cluster (one gap per cluster)",
    "togaf_ref": [
      "11.4",
      "27",
      "28.2",
      "35.6.5"
    ],
    "bf_weights": [
      1,
      1,
      1
    ],
    "tf_weights": [
      1,
      1,
      1,
      1
    ],
    "labels": {
      "Invest": {
        "label": "Invest",
        "desc": "Strategic and healthy: extend and enhance"
      },
      "Tolerate": {
        "label": "Retain",
        "desc": "Technically sound, limited business fit: maintain as-is, no new investment, reassess at renewal"
      },
      "Migrate": {
        "label": "Modernise",
        "desc": "Valuable but technically weak: upgrade, re-platform or re-architect"
      },
      "Eliminate": {
        "label": "Replace",
        "desc": "Low business and technical fit: replace with a fit-for-purpose solution or retire"
      },
      "Consolidate": {
        "label": "Consolidate",
        "desc": "Duplicates a survivor app: migrate users and data, then retire"
      },
      "Retain (out of scope)": {
        "label": "Out of scope",
        "desc": "Retained outside this assessment (SAP RISE, OT); dependencies only"
      }
    },
    "rules": [
      {
        "id": "RR-01",
        "name": "Out-of-scope systems are retained",
        "when": "out_of_scope",
        "then": "Retain (out of scope)",
        "enabled": true,
        "locked": true,
        "basis": [
          "Scope: SAP RISE and OT excluded (deck)"
        ],
        "togaf_ref": "7.4",
        "why": "SAP RISE and OT are outside detailed assessment per the proposal"
      },
      {
        "id": "RR-02",
        "name": "Vendor support ends inside the roadmap",
        "when": "eol_24m",
        "then": "Migrate",
        "enabled": true,
        "basis": [
          "TOGAF-20 Control Technical Diversity",
          "D4"
        ],
        "togaf_ref": "28.2",
        "why": "Lifecycle 'EOL < 24m' turns Invest or Retain into Modernise"
      },
      {
        "id": "RR-03",
        "name": "Security floor for critical apps",
        "when": "security_floor",
        "then": "Migrate",
        "params": {
          "max_security": 2,
          "min_criticality": 4
        },
        "enabled": false,
        "basis": [
          "G-03",
          "TOGAF-15 Data Security"
        ],
        "togaf_ref": "23.6.2",
        "why": "A critical app scoring ≤ 2 on security & compliance cannot stay Invest or Retain"
      },
      {
        "id": "RR-04",
        "name": "Consolidate duplicates onto the survivor",
        "when": "duplicate",
        "then": "Consolidate",
        "enabled": false,
        "basis": [
          "P-CIL-04",
          "TOGAF-05 Common Use Applications"
        ],
        "togaf_ref": "27",
        "why": "Non-survivor members of a duplication cluster are consolidated unless already Replace"
      },
      {
        "id": "RR-05",
        "name": "Clean core: custom apps overlapping SAP",
        "when": "clean_core",
        "then": "Eliminate",
        "params": {
          "core_vendor": "SAP"
        },
        "enabled": false,
        "basis": [
          "P-CIL-02",
          "G-02",
          "G-08"
        ],
        "togaf_ref": "23.6.4",
        "why": "A custom app serving a capability the core ERP already serves is replaced by the standard"
      },
      {
        "id": "RR-06",
        "name": "Protect strategically aligned apps",
        "when": "strategic_protect",
        "then": "Migrate",
        "params": {
          "min_alignment": 4
        },
        "enabled": false,
        "basis": [
          "D5",
          "TOGAF-02 Maximize Benefit"
        ],
        "togaf_ref": "23.6.1",
        "why": "Strategic alignment ≥ 4 turns Replace into Modernise"
      }
    ],
    "conditions": {
      "out_of_scope": "in_scope is false",
      "eol_24m": "lifecycle is 'EOL < 24m' and quadrant is Invest or Retain",
      "security_floor": "security & compliance ≤ max_security and criticality ≥ min_criticality and quadrant is Invest or Retain",
      "duplicate": "member of a duplication cluster, not the survivor, quadrant is not Replace",
      "clean_core": "type Custom and shares a capability with an app from core_vendor",
      "strategic_protect": "quadrant is Replace and strategic alignment ≥ min_alignment"
    }
  },
  "data_rules": {
    "score_weights": {
      "owner": 20,
      "sor": 10,
      "mdm": 20,
