    "gap_priority": "impact * urgency (1-25)",
    "initiative_priority": "max gap priority in theme",
    "size_adjust": "n_gaps <= 2 -> one size smaller; n_gaps >= 6 -> one size larger (S..XL bounds)",
    "wave_rules": [
      "size in [S, M] AND priority >= 16 -> W0",
      "foundation -> W1 (W0 if size == S)",
