# Optional. Without a key every AI call returns the deterministic fallback (rules + TOGAF excerpts).
GEMINI_API_KEY=
# Check AI Studio for the free-tier model IDs currently live.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_RPM=8

# Hosting only. Login gate: name:password pairs, comma-separated. Empty = no login (local use).
APP_USERS=
# Signs the session cookie; set a long random value when hosted.
SESSION_SECRET=
SESSION_HOURS=12
# false = BM25-only retrieval (no embedding model in memory)
RAG_DENSE=true
